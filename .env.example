# AariNAT Sniper V4 — Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to GitHub

# ─── RPC (REQUIRED) ───────────────────────────────────────────────────────────
# Must be a PRIVATE endpoint — Helius or Triton only. Public RPC is too slow.
# Helius: https://dev.helius.xyz/dashboard/app
# Triton:  https://triton.one
RPC_ENDPOINT=https://mainnet.helius-rpc.com/?api-key=YOUR_HELIUS_KEY
RPC_WS_ENDPOINT=wss://mainnet.helius-rpc.com/?api-key=YOUR_HELIUS_KEY

# ─── HELIUS API (recommended) ─────────────────────────────────────────────────
# For token metadata and security enrichment
HELIUS_API_KEY=YOUR_HELIUS_API_KEY

# ─── JITO (for live trading exits) ───────────────────────────────────────────
JITO_ENDPOINT=https://mainnet.block-engine.jito.labs.io/api/v1/bundles

# ─── WALLET (REQUIRED for live trading, optional for paper) ───────────────────
# Base58-encoded private key. GUARD THIS WITH YOUR LIFE.
# Never share, never commit, never paste in chat.
WALLET_PRIVATE_KEY=

# ─── TELEGRAM ─────────────────────────────────────────────────────────────────
# 1. Create a bot via @BotFather → get TELEGRAM_BOT_TOKEN
# 2. Start a chat with the bot, then get your chat ID from:
#    https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ─── TRADING MODE ─────────────────────────────────────────────────────────────
# PAPER_TRADE=false  ← Only set this when paper profit is confirmed
# AUTO_TRADE=true    ← Required for live buys to actually fire
PAPER_TRADE=true
AUTO_TRADE=false

# ─── LOGGING ──────────────────────────────────────────────────────────────────
# DEBUG | INFO | WARN | ERROR
LOG_LEVEL=INFO
